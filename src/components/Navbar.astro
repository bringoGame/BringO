---
import type { Lang } from '../i18n/ui';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
  { label: t('nav.about'), href: '#about' },
  { label: t('nav.packages'), href: '#products' },
  { label: t('nav.franchise'), href: '#franchise' },
  { label: t('nav.reviews'), href: '#testimonials' },
  { label: t('nav.contacts'), href: '#contact' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 h-[100px] flex items-center bg-brand-dark/80 backdrop-blur-md border-b border-white/5">
  <div class="max-w-[1920px] mx-auto w-full flex items-center justify-between px-6 lg:px-[163px]">
    <!-- Logo -->
    <a href={getLocalizedPath('/', lang)} class="flex items-center gap-1 text-2xl font-bold tracking-wider shrink-0">
      <span class="text-brand-cyan">BRING</span><span class="inline-flex items-center justify-center w-8 h-8 border-2 border-brand-magenta rounded-md"><span class="w-2.5 h-2.5 bg-brand-cyan rounded-sm"></span></span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-8 lg:gap-11">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-white/90 hover:text-brand-cyan transition-colors text-base tracking-tight"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Desktop: Language Switcher + CTA -->
    <div class="hidden md:flex items-center gap-4">
      <!-- Language Switcher -->
      <div class="relative" id="lang-switcher">
        <button class="flex items-center gap-1 text-white/70 hover:text-brand-cyan transition-colors text-sm" aria-label="Change language">
          <span>{lang.toUpperCase()}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div id="lang-dropdown" class="hidden absolute top-full right-0 mt-2 bg-brand-dark/95 backdrop-blur-lg border border-white/10 rounded-lg py-1 min-w-[60px]">
          <a href="/" class={`block px-3 py-1.5 text-sm ${lang === 'en' ? 'text-brand-cyan' : 'text-white/70 hover:text-brand-cyan'} transition-colors`}>EN</a>
          <a href="/ru/" class={`block px-3 py-1.5 text-sm ${lang === 'ru' ? 'text-brand-cyan' : 'text-white/70 hover:text-brand-cyan'} transition-colors`}>RU</a>
          <a href="/ro/" class={`block px-3 py-1.5 text-sm ${lang === 'ro' ? 'text-brand-cyan' : 'text-white/70 hover:text-brand-cyan'} transition-colors`}>RO</a>
        </div>
      </div>

    </div>

    <!-- Mobile burger -->
    <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label={t('nav.openMenu')}>
      <span class="block w-6 h-0.5 bg-white transition-transform"></span>
      <span class="block w-6 h-0.5 bg-white transition-opacity"></span>
      <span class="block w-6 h-0.5 bg-white transition-transform"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-[100px] left-0 right-0 bg-brand-dark/95 backdrop-blur-lg border-b border-white/10 p-6">
    <div class="flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-white/90 hover:text-brand-cyan transition-colors text-lg py-2"
        >
          {link.label}
        </a>
      ))}

      <!-- Mobile Language Switcher -->
      <div class="relative" id="lang-switcher-mobile">
        <button class="flex items-center gap-1 text-white/70 hover:text-brand-cyan transition-colors text-sm" aria-label="Change language">
          <span>{lang.toUpperCase()}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div id="lang-dropdown-mobile" class="hidden absolute bottom-full left-0 mb-2 bg-brand-dark/95 backdrop-blur-lg border border-white/10 rounded-lg py-1 min-w-[60px]">
          <a href="/" class={`block px-3 py-1.5 text-sm ${lang === 'en' ? 'text-brand-cyan' : 'text-white/70 hover:text-brand-cyan'} transition-colors`}>EN</a>
          <a href="/ru/" class={`block px-3 py-1.5 text-sm ${lang === 'ru' ? 'text-brand-cyan' : 'text-white/70 hover:text-brand-cyan'} transition-colors`}>RU</a>
          <a href="/ro/" class={`block px-3 py-1.5 text-sm ${lang === 'ro' ? 'text-brand-cyan' : 'text-white/70 hover:text-brand-cyan'} transition-colors`}>RO</a>
        </div>
      </div>

    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const spans = btn.querySelectorAll('span');
    spans[0].classList.toggle('rotate-45');
    spans[0].classList.toggle('translate-y-2');
    spans[1].classList.toggle('opacity-0');
    spans[2].classList.toggle('-rotate-45');
    spans[2].classList.toggle('-translate-y-2');
  });
  // Close on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => menu.classList.add('hidden'));
  });

  // Language switcher toggle (desktop)
  const switcher = document.getElementById('lang-switcher');
  const dropdown = document.getElementById('lang-dropdown');
  switcher?.addEventListener('click', (e) => {
    e.stopPropagation();
    dropdown?.classList.toggle('hidden');
  });

  // Language switcher toggle (mobile)
  const switcherMobile = document.getElementById('lang-switcher-mobile');
  const dropdownMobile = document.getElementById('lang-dropdown-mobile');
  switcherMobile?.addEventListener('click', (e) => {
    e.stopPropagation();
    dropdownMobile?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    dropdown?.classList.add('hidden');
    dropdownMobile?.classList.add('hidden');
  });
</script>
