---
import type { Lang } from '../i18n/ui';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
  { label: t('nav.about'), href: '#about' },
  { label: t('nav.packages'), href: '#products' },
  { label: t('nav.franchise'), href: '#franchise' },
  { label: t('nav.reviews'), href: '#testimonials' },
  { label: t('nav.contacts'), href: '#contact' },
];
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 h-[70px] flex items-center transition-all duration-500 ease-in-out" style="background: transparent;">
  <div class="max-w-[1920px] mx-auto w-full flex items-center justify-between px-6 lg:px-[163px]">
    <!-- Logo -->
    <a href={getLocalizedPath('/', lang)} class="shrink-0">
      <img src="/images/logo.svg" alt="Bringo" class="nav-logo" />
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-[45px]">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class={`nav-link ${i === 0 ? 'nav-link-active' : ''}`}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Desktop: Language Switcher -->
    <div class="hidden md:flex items-center">
      <div class="relative" id="lang-switcher">
        <button class="flex items-center gap-1 text-white/70 hover:text-brand-cyan transition-colors text-sm" aria-label="Change language">
          <span>{lang.toUpperCase()}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div id="lang-dropdown" class="hidden absolute top-full right-0 mt-2 bg-brand-dark/95 backdrop-blur-lg border border-white/10 rounded-lg py-1 min-w-[60px]">
          <a href="/" class={`block px-3 py-1.5 text-sm ${lang === 'en' ? 'text-brand-cyan' : 'text-white/70 hover:text-brand-cyan'} transition-colors`}>EN</a>
          <a href="/ru/" class={`block px-3 py-1.5 text-sm ${lang === 'ru' ? 'text-brand-cyan' : 'text-white/70 hover:text-brand-cyan'} transition-colors`}>RU</a>
          <a href="/ro/" class={`block px-3 py-1.5 text-sm ${lang === 'ro' ? 'text-brand-cyan' : 'text-white/70 hover:text-brand-cyan'} transition-colors`}>RO</a>
        </div>
      </div>
    </div>

    <!-- Mobile: Login + Burger -->
    <div class="mobile-nav-right">
      <a href="#contact" class="mobile-login-btn">{t('nav.login')}</a>
      <button id="mobile-menu-btn" class="burger-btn" aria-label={t('nav.openMenu')}>
        <div class="burger-lines">
          <span class="burger-line burger-line-1"></span>
          <span class="burger-line burger-line-2"></span>
          <span class="burger-line burger-line-3"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile menu (fullscreen) -->
  <div id="mobile-menu" class="mobile-menu-hidden">
    <div class="mobile-menu-content">
      <div class="mobile-menu-links">
        {navLinks.map((link, i) => (
          <a href={link.href} class={`mobile-menu-link ${i === 0 ? 'mobile-menu-link-active' : ''}`}>
            {link.label}
          </a>
        ))}
      </div>

      <!-- Mobile social + language -->
      <div class="mobile-menu-bottom">
        <div class="mobile-menu-social">
          <a href="https://www.instagram.com/bringo_activities" target="_blank" rel="noopener noreferrer">
            <img src="/images/social-instagram.svg" alt="Instagram" class="w-[30px] h-[30px]" />
          </a>
          <a href="https://t.me/bring_O" target="_blank" rel="noopener noreferrer">
            <img src="/images/social-telegram.svg" alt="Telegram" class="w-[30px] h-[30px]" />
          </a>
          <a href="https://wa.me/380731139800" target="_blank" rel="noopener noreferrer">
            <img src="/images/icon-whatsapp.svg" alt="WhatsApp" class="w-[36px] h-[30px]" />
          </a>
        </div>
        <div class="mobile-menu-langs">
          <a href="/" class={lang === 'en' ? 'mobile-lang-active' : 'mobile-lang'}>EN</a>
          <a href="/ru/" class={lang === 'ru' ? 'mobile-lang-active' : 'mobile-lang'}>RU</a>
          <a href="/ro/" class={lang === 'ro' ? 'mobile-lang-active' : 'mobile-lang'}>RO</a>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .nav-logo {
    width: auto;
    height: 65px;
  }

  .nav-link {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 150%;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    opacity: 0.9;
    text-decoration: none;
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-link:hover {
    color: #5CE1E6;
  }

  .nav-link-active {
    color: #5CE1E6;
  }

  .nav-link-active::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 100%;
    height: 3px;
    background: #5CE1E6;
  }

  /* Burger button */
  .burger-btn {
    display: none;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .burger-lines {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    width: 34px;
  }

  .burger-line {
    display: block;
    height: 2.3px;
    background: #FFFFFF;
    transition: all 0.3s ease;
  }

  .burger-line-1 { width: 34px; }
  .burger-line-2 { width: 26px; }
  .burger-line-3 { width: 34px; }

  .burger-open .burger-line-1 {
    transform: rotate(45deg) translateY(6px) translateX(6px);
  }
  .burger-open .burger-line-2 {
    opacity: 0;
  }
  .burger-open .burger-line-3 {
    transform: rotate(-45deg) translateY(-6px) translateX(6px);
  }

  /* Mobile menu */
  .mobile-menu-hidden {
    display: none;
  }

  .mobile-menu-visible {
    display: flex;
    position: fixed;
    top: 70px;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(180deg, #260B40 0%, #461276 100%);
    z-index: 100;
    animation: menuSlideIn 0.3s ease;
  }

  @keyframes menuSlideIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .mobile-menu-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px 20px;
    width: 100%;
    height: 100%;
  }

  .mobile-menu-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 45px;
  }

  .mobile-menu-link {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 150%;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    opacity: 0.9;
    text-decoration: none;
    text-align: right;
    transition: color 0.2s ease;
  }

  .mobile-menu-link:hover {
    color: #5CE1E6;
  }

  .mobile-menu-link-active {
    color: #5CE1E6;
  }

  .mobile-menu-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 40px;
  }

  .mobile-menu-social {
    display: flex;
    align-items: center;
    gap: 45px;
  }

  .mobile-menu-langs {
    display: flex;
    gap: 12px;
  }

  .mobile-lang, .mobile-lang-active {
    font-size: 16px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .mobile-lang {
    color: rgba(255, 255, 255, 0.5);
  }

  .mobile-lang:hover {
    color: #5CE1E6;
  }

  .mobile-lang-active {
    color: #5CE1E6;
  }

  .mobile-nav-right {
    display: none;
  }

  .mobile-login-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 25px;
    background: #E43AD7;
    border-radius: 10px;
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 24px;
    color: #FFFFFF;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .nav-logo {
      width: 94.55px;
      height: 35px;
    }

    .mobile-nav-right {
      display: flex;
      align-items: center;
      gap: 35px;
    }

    .burger-btn {
      display: block;
    }

    .mobile-menu-visible {
      top: 66px;
    }

    .mobile-menu-social img {
      filter: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  const nav = document.getElementById('main-nav');

  function applyMenuBg() {
    if (nav) {
      nav.style.background = 'linear-gradient(180deg, #260B40 0%, #461276 100%)';
      nav.style.backdropFilter = 'none';
      nav.style.borderBottom = 'none';
      nav.classList.add('menu-open');
    }
  }

  function removeMenuBg() {
    if (nav) {
      nav.classList.remove('menu-open');
      // Re-apply scroll-based bg
      if (window.scrollY > 50) {
        nav.style.background = 'rgba(26, 10, 46, 0.85)';
        nav.style.backdropFilter = 'blur(12px)';
        nav.style.borderBottom = '1px solid rgba(255, 255, 255, 0.05)';
      } else {
        nav.style.background = 'transparent';
        nav.style.backdropFilter = 'none';
        nav.style.borderBottom = 'none';
      }
    }
  }

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('mobile-menu-visible');
    if (isOpen) {
      menu?.classList.remove('mobile-menu-visible');
      menu?.classList.add('mobile-menu-hidden');
      btn.classList.remove('burger-open');
      document.body.style.overflow = '';
      removeMenuBg();
    } else {
      menu?.classList.remove('mobile-menu-hidden');
      menu?.classList.add('mobile-menu-visible');
      btn.classList.add('burger-open');
      document.body.style.overflow = 'hidden';
      applyMenuBg();
    }
  });

  // Close menu on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.remove('mobile-menu-visible');
      menu.classList.add('mobile-menu-hidden');
      btn?.classList.remove('burger-open');
      document.body.style.overflow = '';
      removeMenuBg();
    });
  });

  // Language switcher toggle (desktop)
  const switcher = document.getElementById('lang-switcher');
  const dropdown = document.getElementById('lang-dropdown');
  switcher?.addEventListener('click', (e) => {
    e.stopPropagation();
    dropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    dropdown?.classList.add('hidden');
  });

  // Navbar background on scroll
  window.addEventListener('scroll', () => {
    if (nav?.classList.contains('menu-open')) return;
    if (window.scrollY > 50) {
      nav!.style.background = 'rgba(26, 10, 46, 0.85)';
      nav!.style.backdropFilter = 'blur(12px)';
      nav!.style.borderBottom = '1px solid rgba(255, 255, 255, 0.05)';
    } else {
      nav!.style.background = 'transparent';
      nav!.style.backdropFilter = 'none';
      nav!.style.borderBottom = 'none';
    }
  });

  // Highlight active nav link on scroll
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');
  window.addEventListener('scroll', () => {
    let current = '';
    sections.forEach(section => {
      const top = section.offsetTop - 150;
      if (window.scrollY >= top) {
        current = '#' + section.id;
      }
    });
    navLinks.forEach(link => {
      link.classList.remove('nav-link-active');
      if (link.getAttribute('href') === current) {
        link.classList.add('nav-link-active');
      }
    });
  });
</script>
