---
import type { Lang } from '../i18n/ui';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<footer class="py-10 px-6 lg:px-[236px] border-t border-white/10">
  <div class="max-w-[1920px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    <!-- Logo -->
    <a href={getLocalizedPath('/', lang)} class="shrink-0">
      <img src="/images/logo.svg" alt="Bringo" class="h-6" />
    </a>

    <p class="text-xs text-white/40">
      &copy; {new Date().getFullYear()} Bringo Activities. {t('footer.rights')}
    </p>

    <!-- Language links -->
    <div class="flex items-center gap-2 text-xs">
      <a href="/" class={`${lang === 'en' ? 'text-brand-cyan' : 'text-white/40 hover:text-brand-cyan'} transition-colors`}>EN</a>
      <span class="text-white/20">|</span>
      <a href="/ru/" class={`${lang === 'ru' ? 'text-brand-cyan' : 'text-white/40 hover:text-brand-cyan'} transition-colors`}>RU</a>
      <span class="text-white/20">|</span>
      <a href="/ro/" class={`${lang === 'ro' ? 'text-brand-cyan' : 'text-white/40 hover:text-brand-cyan'} transition-colors`}>RO</a>
    </div>

    <div class="flex items-center gap-4">
      <a href="https://www.instagram.com/bringo_activities" target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-brand-magenta transition-colors" aria-label="Instagram">
        <img src="/images/social-instagram.svg" alt="Instagram" class="w-5 h-5" />
      </a>
      <a href="https://t.me/bring_O" target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-brand-cyan transition-colors" aria-label="Telegram">
        <img src="/images/social-telegram.svg" alt="Telegram" class="w-5 h-5" />
      </a>
    </div>
  </div>
</footer>
