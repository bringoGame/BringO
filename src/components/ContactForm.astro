---
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedArray } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const ta = useTranslatedArray(lang);
---

<section id="contact" class="py-16 lg:py-24 px-6 lg:px-[170px]">
  <div class="max-w-[1920px] mx-auto">
    <h2 class="text-xl lg:text-2xl font-bold text-center mb-10">{t('contact.title')}</h2>

    <div class="flex flex-col lg:flex-row gap-0 rounded-2xl overflow-hidden">
      <!-- Form -->
      <div class="lg:w-[40%] bg-brand-purple/50 p-8 lg:p-14">
        <h3 class="text-xl font-bold mb-8">{t('contact.formTitle')}</h3>
        <form
          id="contact-form"
          class="flex flex-col gap-6"
          data-sending={t('contact.sending')}
          data-success={t('contact.success')}
          data-error={t('contact.error')}
        >
          <div>
            <label for="name" class="text-xs text-white/60 mb-1 block">{t('contact.nameLabel')}</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full bg-transparent border-b border-white/30 pb-2 text-white text-sm outline-none focus:border-brand-cyan transition-colors placeholder:text-white/30"
              placeholder={t('contact.namePlaceholder')}
            />
          </div>
          <div>
            <label for="phone" class="text-xs text-white/60 mb-1 block">{t('contact.phoneLabel')}</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              class="w-full bg-transparent border-b border-white/30 pb-2 text-white text-sm outline-none focus:border-brand-cyan transition-colors placeholder:text-white/30"
              placeholder={t('contact.phonePlaceholder')}
            />
          </div>
          <div>
            <label for="message" class="text-xs text-white/60 mb-1 block">{t('contact.messageLabel')}</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full bg-white/5 border border-white/10 rounded-lg p-3 text-white text-sm outline-none focus:border-brand-cyan transition-colors resize-none placeholder:text-white/30"
              placeholder={t('contact.messagePlaceholder')}
            ></textarea>
          </div>
          <button type="submit" class="btn-primary w-fit">
            {t('contact.submit')}
          </button>
          <p id="form-status" class="text-sm hidden"></p>
        </form>
      </div>

      <!-- Contact info -->
      <div class="lg:w-[60%] bg-brand-purple/30 p-8 lg:p-14 flex flex-col gap-8">
        <div>
          <h3 class="text-lg font-bold mb-2">{t('contact.infoTitle')}</h3>
          <p class="text-sm text-white/70 leading-relaxed">
            {t('contact.infoText')}
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          <!-- Left: Phone, email, location -->
          <div class="flex flex-col gap-5">
            <h4 class="text-sm font-semibold text-white/50">{t('contact.contactsLabel')}</h4>
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-5 text-brand-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              <a href="tel:+40725462986" class="text-sm text-white/80 hover:text-brand-cyan transition-colors">+40 725 462 986</a>
            </div>
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              <a href="mailto:info@bring-o.net" class="text-sm text-white/80 hover:text-brand-cyan transition-colors">info@bring-o.net</a>
            </div>
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <span class="text-sm text-white/80">{t('contact.city')}</span>
            </div>
          </div>

          <!-- Right: Social -->
          <div class="flex flex-col gap-5">
            <h4 class="text-sm font-semibold text-white/50">{t('contact.socialLabel')}</h4>
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-magenta shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              <a href="https://www.instagram.com/bringo_activities" target="_blank" rel="noopener noreferrer" class="text-sm text-white/80 hover:text-brand-magenta transition-colors">bringo_activities</a>
            </div>
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-cyan shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
              <a href="https://t.me/bring_O" target="_blank" rel="noopener noreferrer" class="text-sm text-white/80 hover:text-brand-cyan transition-colors">bring_O</a>
            </div>
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-5 text-brand-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              <a href="tel:+380731139800" class="text-sm text-white/80 hover:text-brand-cyan transition-colors">+380 731 139 800</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const body = {
      name: data.get('name'),
      phone: data.get('phone'),
      message: data.get('message'),
    };

    const sendingText = form.dataset.sending || 'Sending...';
    const successText = form.dataset.success || 'Thank you!';
    const errorText = form.dataset.error || 'Error. Please try again later.';

    status.classList.remove('hidden');
    status.textContent = sendingText;
    status.className = 'text-sm text-brand-cyan';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        status.textContent = successText;
        status.className = 'text-sm text-green-400';
        form.reset();
      } else {
        throw new Error('Server error');
      }
    } catch {
      status.textContent = errorText;
      status.className = 'text-sm text-red-400';
    }
  });
</script>
