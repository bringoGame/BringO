---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="py-16 lg:py-24 px-6 lg:px-[170px]">
  <div class="max-w-[1920px] mx-auto">
    <h2 class="section-title mb-10">{t('contact.title')}</h2>

    <div class="contact-layout">
      <!-- Form block -->
      <div class="contact-form-block">
        <h3 class="contact-form-title">{t('contact.formTitle')}</h3>
        <form
          id="contact-form"
          class="contact-form"
          data-sending={t('contact.sending')}
          data-success={t('contact.success')}
          data-error={t('contact.error')}
        >
          <div class="contact-field">
            <input
              type="text"
              id="name"
              name="name"
              required
              class="contact-input"
              placeholder={t('contact.nameLabel')}
            />
            <div class="contact-input-line"></div>
          </div>
          <div class="contact-field">
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              class="contact-input"
              placeholder={t('contact.phoneLabel')}
            />
            <div class="contact-input-line"></div>
          </div>
          <div class="contact-field">
            <textarea
              id="message"
              name="message"
              rows="5"
              class="contact-textarea"
              placeholder={t('contact.messageLabel')}
            ></textarea>
          </div>
          <button type="submit" class="contact-submit">{t('contact.submit')}</button>
          <p id="form-status" class="text-sm hidden"></p>
        </form>
      </div>

      <!-- Info block -->
      <div class="contact-info-block">
        <div class="contact-info-header">
          <h3 class="contact-info-title">{t('contact.infoTitle')}</h3>
          <p class="contact-info-desc">{t('contact.infoText')}</p>
        </div>

        <div class="contact-details">
          <!-- Contacts column -->
          <div class="contact-column">
            <h4 class="contact-column-title">{t('contact.contactsLabel')}</h4>
            <div class="contact-links">
              <div class="contact-link-row">
                <img src="/images/icon-phone.svg" alt="" class="contact-icon" />
                <a href="tel:+40725462986" class="contact-link">+40 725 462 986</a>
              </div>
              <div class="contact-link-row">
                <img src="/images/icon-email.svg" alt="" class="contact-icon" />
                <a href="mailto:info@bring-o.net" class="contact-link contact-link-underline">info@bring-o.net</a>
              </div>
              <div class="contact-link-row">
                <img src="/images/icon-city.svg" alt="" class="contact-icon" />
                <span class="contact-link">{t('contact.city')}</span>
              </div>
            </div>
          </div>

          <!-- Social column -->
          <div class="contact-column">
            <h4 class="contact-column-title">{t('contact.socialLabel')}</h4>
            <div class="contact-links">
              <div class="contact-link-row">
                <img src="/images/icon-instagram.svg" alt="" class="contact-icon" />
                <a href="https://www.instagram.com/bringo_activities" target="_blank" rel="noopener noreferrer" class="contact-link contact-link-underline">bringo_activities</a>
              </div>
              <div class="contact-link-row">
                <img src="/images/icon-whatsapp.svg" alt="" class="contact-icon" />
                <a href="tel:+380731139800" class="contact-link contact-link-underline">+380 731 139 800</a>
              </div>
              <div class="contact-link-row">
                <img src="/images/icon-telegram.svg" alt="" class="contact-icon" />
                <a href="https://t.me/bring_O" target="_blank" rel="noopener noreferrer" class="contact-link contact-link-underline">bring_O</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-layout {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .contact-form-block,
  .contact-info-block {
    box-sizing: border-box;
    background: linear-gradient(90deg, rgba(65, 150, 211, 0.3008) 0%, rgba(235, 60, 222, 0.47) 100%);
    border: 4px solid #57CCD5;
    border-radius: 16px;
    padding: 62px 50px;
  }

  .contact-form-title {
    font-family: 'Roboto Slab', serif;
    font-weight: 700;
    font-size: 32px;
    line-height: 91%;
    color: #FFFFFF;
    margin-bottom: 50px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  .contact-field {
    position: relative;
  }

  .contact-input {
    width: 290px;
    max-width: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 126%;
    color: #FFFFFF;
    padding: 8px 0;
  }

  .contact-input::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .contact-input-line {
    width: 290px;
    max-width: 100%;
    height: 1px;
    background: #FFFFFF;
  }

  .contact-textarea {
    width: 290px;
    max-width: 100%;
    height: 130px;
    background: #FFFFFF;
    border: 1px solid #FFFFFF;
    border-radius: 4px;
    padding: 12px;
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 126%;
    color: #000000;
    resize: none;
    outline: none;
  }

  .contact-textarea::placeholder {
    color: rgba(0, 0, 0, 0.4);
  }

  .contact-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 20px 25px;
    width: fit-content;
    background: #EB3CDE;
    border-radius: 10px;
    border: none;
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 24px;
    color: #FFFFFF;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .contact-submit:hover {
    background: #d632c9;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(235, 60, 222, 0.4);
  }

  .contact-info-header {
    display: flex;
    flex-direction: column;
    gap: 36px;
    margin-bottom: 45px;
  }

  .contact-info-title {
    font-family: 'Roboto Slab', serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 115%;
    color: #FFFFFF;
  }

  .contact-info-desc {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 115%;
    color: #FFFFFF;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .contact-column-title {
    font-family: 'Roboto Slab', serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 115%;
    color: #FFFFFF;
    margin-bottom: 25px;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  .contact-link-row {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .contact-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .contact-link {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 30px;
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-link:hover {
    color: #57CCD5;
  }

  .contact-link-underline {
    text-decoration: underline;
  }

  @media (min-width: 1024px) {
    .contact-layout {
      flex-direction: row;
    }

    .contact-form-block {
      width: 39%;
      min-height: 553px;
    }

    .contact-info-block {
      width: 61%;
      min-height: 553px;
    }

    .contact-details {
      flex-direction: row;
      gap: 58px;
    }
  }

  @media (max-width: 1023px) {
    .contact-form-block,
    .contact-info-block {
      padding: 32px 24px;
    }

    .contact-form-title {
      font-size: 24px;
    }

    .contact-info-desc {
      font-size: 16px;
    }

    .contact-link {
      font-size: 16px;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const body = {
      name: data.get('name'),
      phone: data.get('phone'),
      message: data.get('message'),
    };

    const sendingText = form.dataset.sending || 'Sending...';
    const successText = form.dataset.success || 'Thank you!';
    const errorText = form.dataset.error || 'Error. Please try again later.';

    status.classList.remove('hidden');
    status.textContent = sendingText;
    status.className = 'text-sm text-brand-cyan';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        status.textContent = successText;
        status.className = 'text-sm text-green-400';
        form.reset();
      } else {
        throw new Error('Server error');
      }
    } catch {
      status.textContent = errorText;
      status.className = 'text-sm text-red-400';
    }
  });
</script>
