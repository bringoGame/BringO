---
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedArray } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const ta = useTranslatedArray(lang);

const reviews = ta('testimonials.items') as {text: string, name: string}[];
const avatars = ['/images/avatar-1.png', '/images/avatar-2.png', '/images/avatar-3.png'];
---

<section id="testimonials" class="py-16 lg:py-24 px-6 lg:px-[166px]">
  <div class="max-w-[1920px] mx-auto">
    <div class="flex items-center justify-between mb-10">
      <h2 class="section-title flex-1">{t('testimonials.title')}</h2>
      <div class="flex gap-3">
        <button id="review-prev" class="carousel-arrow" aria-label="Prev">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <button id="review-next" class="carousel-arrow" aria-label="Next">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>

    <div class="review-viewport" id="review-viewport">
      <div class="review-track" id="review-track">
        {reviews.map((r, i) => (
          <div class="review-card">
            <p class="review-text">{r.text}</p>
            <div class="review-author">
              <div class="review-avatar">
                <img src={avatars[i]} alt={r.name} class="w-full h-full object-cover" loading="lazy" />
              </div>
              <span class="review-name">{r.name}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Dot indicators (mobile only) -->
    <div class="review-dots" id="review-dots">
      {reviews.map((_, i) => (
        <button class={`review-dot ${i === 0 ? 'review-dot-active' : ''}`} data-index={i} aria-label={`Review ${i + 1}`} />
      ))}
    </div>
  </div>
</section>

<style>
  .carousel-arrow {
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: #EB3CDE;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    color: white;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .carousel-arrow:hover {
    background: #d632c9;
    transform: scale(1.05);
    box-shadow: 0 4px 15px rgba(235, 60, 222, 0.4);
  }

  .review-viewport {
    overflow: hidden;
  }

  .review-track {
    display: flex;
    gap: 29px;
    transition: transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
    will-change: transform;
    cursor: grab;
  }

  .review-track:active {
    cursor: grabbing;
  }

  .review-card {
    box-sizing: border-box;
    flex: 0 0 calc(33.333% - 20px);
    min-width: 300px;
    min-height: 361px;
    background: linear-gradient(90deg, rgba(65, 150, 211, 0.3008) 0%, rgba(235, 60, 222, 0.47) 100%);
    border: 4px solid #5CE1E6;
    border-radius: 18px;
    padding: 37px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .review-text {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 115%;
    color: #FFFFFF;
  }

  .review-author {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .review-avatar {
    width: 66px;
    height: 66px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: linear-gradient(90deg, #7C26D1 0%, #F25C3A 100%);
  }

  .review-name {
    font-family: 'Roboto', sans-serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 27px;
    color: #FFFFFF;
  }

  @media (max-width: 1024px) {
    .review-card {
      flex: 0 0 calc(50% - 15px);
    }
  }

  .review-dots {
    display: none;
  }

  .review-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 0.64px solid #57CCD5;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .review-dot-active {
    background: #57CCD5;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .review-card {
      flex: 0 0 calc(50% - 15px);
    }

    .carousel-arrow {
      display: flex;
    }

    .review-dots {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .carousel-arrow {
      display: none;
    }

    .review-card {
      flex: 0 0 100%;
      min-height: 227px;
      border-width: 2.62px;
      border-radius: 12px;
      padding: 25px;
    }
    .review-text { font-size: 16px; }
    .review-name { font-size: 16px; }

    .review-avatar {
      width: 45px;
      height: 45px;
    }

    .review-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 30px;
      margin-top: 20px;
    }
  }
</style>

<script>
  (function() {
    const track = document.getElementById('review-track') as HTMLElement;
    const viewport = document.getElementById('review-viewport') as HTMLElement;
    const prev = document.getElementById('review-prev');
    const next = document.getElementById('review-next');
    const cards = track.querySelectorAll('.review-card');
    let current = 0;

    function getCardWidth() {
      const card = cards[0] as HTMLElement;
      return card.offsetWidth + 29; // width + gap
    }

    function getMaxScroll() {
      return Math.max(0, track.scrollWidth - viewport.clientWidth);
    }

    const dots = document.querySelectorAll('#review-dots .review-dot');

    function updateDots() {
      dots.forEach((dot, i) => {
        dot.classList.toggle('review-dot-active', i === current);
      });
    }

    function goTo(index: number) {
      const max = getMaxScroll();
      const offset = index * getCardWidth();
      if (offset > max) { current = 0; track.style.transform = 'translateX(0)'; updateDots(); return; }
      if (offset < 0) { current = 0; track.style.transform = 'translateX(0)'; updateDots(); return; }
      current = index;
      track.style.transform = `translateX(-${offset}px)`;
      updateDots();
    }

    prev?.addEventListener('click', () => goTo(current - 1));
    next?.addEventListener('click', () => goTo(current + 1));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(Number((dot as HTMLElement).dataset.index));
      });
    });

    // Mouse drag
    let isDragging = false;
    let startX = 0;
    let startScroll = 0;

    track.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
      startScroll = current * getCardWidth();
      track.style.transition = 'none';
      track.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const diff = startX - e.clientX;
      const max = getMaxScroll();
      const offset = Math.max(0, Math.min(startScroll + diff, max));
      track.style.transform = `translateX(-${offset}px)`;
    });

    window.addEventListener('mouseup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1)';
      track.style.cursor = 'grab';
      const diff = startX - e.clientX;
      if (Math.abs(diff) > 50) {
        diff > 0 ? goTo(current + 1) : goTo(current - 1);
      } else {
        goTo(current);
      }
    });

    // Touch swipe
    track.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startScroll = current * getCardWidth();
      track.style.transition = 'none';
    });

    track.addEventListener('touchmove', (e) => {
      const diff = startX - e.touches[0].clientX;
      const max = getMaxScroll();
      const offset = Math.max(0, Math.min(startScroll + diff, max));
      track.style.transform = `translateX(-${offset}px)`;
    });

    track.addEventListener('touchend', (e) => {
      track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1)';
      const diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        diff > 0 ? goTo(current + 1) : goTo(current - 1);
      } else {
        goTo(current);
      }
    });
  })();
</script>
