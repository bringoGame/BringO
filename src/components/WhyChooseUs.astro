---
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedArray } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const ta = useTranslatedArray(lang);
const benefits = ta('whyChooseUs.items') as {icon: string, label: string}[];
const iconPaths = ['/images/icon-document.svg', '/images/icon-time.svg', '/images/icon-people.svg', '/images/icon-verified.svg', '/images/icon-system.svg'];
---

<section class="py-16 lg:py-20 px-6">
  <div class="max-w-[1920px] mx-auto">
    <h2 class="wcu-title">
      {t('whyChooseUs.title')}
    </h2>

    <div class="wcu-grid">
      {benefits.map((b, i) => (
        <div class="wcu-badge">
          <img src={iconPaths[i]} alt="" class="w-10 h-10" />
          <span class="wcu-label">{b.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .wcu-title {
    font-family: 'Roboto Slab', serif;
    font-weight: 800;
    font-size: 36px;
    line-height: 115%;
    text-align: center;
    text-transform: uppercase;
    color: #FFFFFF;
    margin-bottom: 86px;
  }

  .wcu-grid {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 35px;
    flex-wrap: wrap;
  }

  .wcu-badge {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 194px;
    height: 120px;
    border: 4px solid #57CCD5;
    border-radius: 16px;
    filter: drop-shadow(0px 4px 21.7px rgba(92, 225, 230, 0.5));
  }

  .wcu-label {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 115%;
    text-align: center;
    color: #FFFFFF;
  }

  @media (max-width: 1024px) {
    .wcu-title {
      font-size: 24px;
      margin-bottom: 40px;
    }

    .wcu-grid {
      gap: 16px;
    }

    .wcu-badge {
      width: 150px;
      height: 100px;
    }
  }
</style>
