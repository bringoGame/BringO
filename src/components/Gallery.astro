---
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedArray } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const ta = useTranslatedArray(lang);

const alts = ta('gallery.alts') as string[];
const images = [
  '/images/gallery-1.png',
  '/images/gallery-2.png',
  '/images/gallery-3.png',
];
---

<section class="py-16 lg:py-24 px-6 lg:px-[163px]">
  <div class="max-w-[1920px] mx-auto">
    <div class="flex items-center justify-between mb-10">
      <h2 class="section-title flex-1">{t('gallery.title')}</h2>
      <div class="flex gap-3">
        <button id="gallery-prev" class="gallery-arrow" aria-label="Prev">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <button id="gallery-next" class="gallery-arrow" aria-label="Next">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>

    <!-- 3-panel carousel -->
    <div class="gallery-stage" id="gallery-stage">
      <!-- Left peek -->
      <div class="gallery-side gallery-left" id="gallery-left">
        <img src="" alt="" class="gallery-side-img" />
      </div>
      <!-- Center main -->
      <div class="gallery-center" id="gallery-center">
        <img src="" alt="" class="gallery-center-img" />
      </div>
      <!-- Right peek -->
      <div class="gallery-side gallery-right" id="gallery-right">
        <img src="" alt="" class="gallery-side-img" />
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-arrow {
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: #EB3CDE;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    color: white;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .gallery-arrow:hover {
    background: #d632c9;
    transform: scale(1.05);
    box-shadow: 0 4px 15px rgba(235, 60, 222, 0.4);
  }

  .gallery-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-height: 450px;
  }

  .gallery-center {
    width: 782px;
    height: 450px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0px 30px 58.4px rgba(0, 0, 0, 0.25);
    flex-shrink: 0;
    z-index: 2;
    transition: opacity 0.4s ease;
  }

  .gallery-center-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-side {
    width: 387px;
    height: 222px;
    border-radius: 16px;
    overflow: hidden;
    flex-shrink: 0;
    z-index: 1;
    opacity: 0.7;
    transition: opacity 0.4s ease;
  }

  .gallery-side:hover {
    opacity: 1;
  }

  .gallery-side-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 1200px) {
    .gallery-side {
      display: none;
    }

    .gallery-center {
      width: 100%;
      height: auto;
      aspect-ratio: 782 / 450;
    }
  }

  @media (max-width: 640px) {
    .gallery-stage {
      min-height: 250px;
    }
  }
</style>

<script>
  const images = [
    '/images/gallery-1.png',
    '/images/gallery-2.png',
    '/images/gallery-3.png',
  ];
  const total = images.length;
  let current = 0;

  const centerImg = document.querySelector('#gallery-center img') as HTMLImageElement;
  const leftImg = document.querySelector('#gallery-left img') as HTMLImageElement;
  const rightImg = document.querySelector('#gallery-right img') as HTMLImageElement;
  const prev = document.getElementById('gallery-prev');
  const next = document.getElementById('gallery-next');

  function render() {
    const leftIdx = (current - 1 + total) % total;
    const rightIdx = (current + 1) % total;
    centerImg.src = images[current];
    leftImg.src = images[leftIdx];
    rightImg.src = images[rightIdx];
  }

  prev?.addEventListener('click', () => {
    current = (current - 1 + total) % total;
    render();
  });

  next?.addEventListener('click', () => {
    current = (current + 1) % total;
    render();
  });

  // Init
  render();

  // Auto-play
  let interval = setInterval(() => { current = (current + 1) % total; render(); }, 5000);
  document.getElementById('gallery-stage')?.addEventListener('mouseenter', () => clearInterval(interval));
  document.getElementById('gallery-stage')?.addEventListener('mouseleave', () => {
    interval = setInterval(() => { current = (current + 1) % total; render(); }, 5000);
  });

  // Touch/swipe
  let startX = 0;
  document.getElementById('gallery-stage')?.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; });
  document.getElementById('gallery-stage')?.addEventListener('touchend', (e) => {
    const diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) {
      current = diff > 0 ? (current + 1) % total : (current - 1 + total) % total;
      render();
    }
  });
</script>
