---
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedArray } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const ta = useTranslatedArray(lang);

const alts = ta('gallery.alts');
---

<section class="py-16 lg:py-24 px-6 lg:px-[163px]">
  <div class="max-w-[1920px] mx-auto">
    <div class="flex items-center justify-between mb-10">
      <h2 class="text-xl lg:text-2xl font-bold text-center flex-1">{t('gallery.title')}</h2>
      <div class="hidden sm:flex gap-3">
        <button id="gallery-prev" class="w-[55px] h-[55px] rounded-full border border-white/20 flex items-center justify-center hover:border-brand-cyan/50 transition-colors" aria-label="Prev">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <button id="gallery-next" class="w-[55px] h-[55px] rounded-full border border-white/20 flex items-center justify-center hover:border-brand-cyan/50 transition-colors" aria-label="Next">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>

    <div class="relative overflow-hidden">
      <div id="gallery-track" class="flex gap-6 transition-transform duration-500 ease-in-out">
        <div class="flex-none w-[280px] sm:w-[387px] h-[200px] sm:h-[222px] rounded-xl overflow-hidden bg-brand-purple/60">
          <img src="/images/gallery-1.png" alt={alts[0]} class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="flex-none w-[500px] sm:w-[782px] h-[300px] sm:h-[450px] rounded-xl overflow-hidden bg-brand-purple/60">
          <img src="/images/gallery-2.png" alt={alts[1]} class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="flex-none w-[280px] sm:w-[387px] h-[200px] sm:h-[222px] rounded-xl overflow-hidden bg-brand-purple/60">
          <img src="/images/gallery-3.png" alt={alts[2]} class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="flex-none w-[500px] sm:w-[782px] h-[300px] sm:h-[450px] rounded-xl overflow-hidden bg-brand-purple/60">
          <img src="/images/gallery-1.png" alt={alts[3]} class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="flex-none w-[280px] sm:w-[387px] h-[200px] sm:h-[222px] rounded-xl overflow-hidden bg-brand-purple/60">
          <img src="/images/gallery-2.png" alt={alts[4]} class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let pos = 0;
  const track = document.getElementById('gallery-track');
  const prev = document.getElementById('gallery-prev');
  const next = document.getElementById('gallery-next');
  const step = 400;

  function getMaxScroll() {
    if (!track) return 0;
    return Math.max(0, track.scrollWidth - track.parentElement!.clientWidth);
  }

  next?.addEventListener('click', () => {
    pos = Math.min(pos + step, getMaxScroll());
    track!.style.transform = `translateX(-${pos}px)`;
  });

  prev?.addEventListener('click', () => {
    pos = Math.max(pos - step, 0);
    track!.style.transform = `translateX(-${pos}px)`;
  });
</script>
