---
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedArray } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const ta = useTranslatedArray(lang);
const items = ta('features.items') as {icon: string, title: string, text: string}[];
const iconPaths = ['/images/icon-brain.svg', '/images/icon-trophy.svg', '/images/icon-button.svg', '/images/icon-audience.svg'];
---

<section id="features" class="py-16 lg:py-24 px-6 lg:px-[253px]">
  <div class="max-w-[1920px] mx-auto">
    <h2 class="feature-title">
      {t('features.title')} <span class="text-brand-cyan">&laquo;{t('features.titleHighlight')}&raquo;</span>?
    </h2>

    <div class="feature-grid" id="feature-grid">
      {items.map((f, i) => (
        <div class={`feature-card ${i === 0 ? 'feature-card-active' : ''}`} data-index={i}>
          <img src={iconPaths[i]} alt="" class="w-10 h-10" />
          <h3 class="feature-card-title">{f.title}</h3>
          <p class="feature-card-text">{f.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-title {
    font-family: 'Roboto Slab', serif;
    font-weight: 800;
    font-size: 36px;
    line-height: 115%;
    text-align: center;
    text-transform: uppercase;
    color: #FFFFFF;
    margin-bottom: 64px;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 320px);
    gap: 24px;
    justify-content: center;
  }

  .feature-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    padding: 48px 32px;
    border: 4px solid transparent;
    border-radius: 16px;
    background: transparent;
    transition: all 0.4s ease;
    cursor: pointer;
  }

  .feature-card-active {
    background: linear-gradient(90deg, rgba(65, 150, 211, 0.3008) 0%, rgba(235, 60, 222, 0.47) 100%);
    border-color: #57CCD5;
    box-shadow: 0px 4px 20px rgba(92, 225, 230, 0.5);
  }

  .feature-card-title {
    font-family: 'Roboto Slab', serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 115%;
    text-transform: uppercase;
    color: #57CCD5;
    transition: color 0.4s ease;
  }

  .feature-card-active .feature-card-title {
    color: #FFFFFF;
  }

  .feature-card-text {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 115%;
    color: #FFFFFF;
  }

  @media (max-width: 1024px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .feature-card {
      width: 100%;
    }
    .feature-title {
      font-size: 24px;
    }
  }

  @media (max-width: 768px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
    .feature-title {
      font-size: 24px;
      margin-bottom: 32px;
    }
    .feature-card {
      padding: 32px 24px;
      gap: 16px;
    }
  }
</style>

<script>
  const grid = document.getElementById('feature-grid');
  const cards = grid?.querySelectorAll('.feature-card');

  cards?.forEach(card => {
    card.addEventListener('mouseenter', () => {
      cards.forEach(c => c.classList.remove('feature-card-active'));
      card.classList.add('feature-card-active');
    });
  });
</script>
