---
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedArray } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const ta = useTranslatedArray(lang);
const items = ta('features.items') as {icon: string, title: string, text: string}[];
---

<section id="features" class="py-16 lg:py-24 px-6 lg:px-[253px]">
  <div class="max-w-[1920px] mx-auto">
    <h2 class="text-xl lg:text-2xl font-bold text-center mb-12 lg:mb-16">
      {t('features.title')} <span class="text-brand-cyan">&laquo;{t('features.titleHighlight')}&raquo;</span>?
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {items.map((f) => (
        <div class="glass-card p-8 flex flex-col items-center text-center gap-4 hover:border-brand-cyan/30 transition-colors">
          <span class="text-4xl">{f.icon}</span>
          <h3 class="text-lg font-semibold">{f.title}</h3>
          <p class="text-sm text-white/70 leading-relaxed">{f.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
