---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="products" class="py-16 lg:py-24 px-6 lg:px-[172px]">
  <div class="max-w-[1920px] mx-auto flex flex-col gap-10">
    <!-- Product 1: Questions package -->
    <div class="flex flex-col lg:flex-row gap-0 rounded-2xl overflow-hidden">
      <div class="lg:w-[60%] bg-brand-purple/40 p-8 lg:p-16 flex flex-col justify-center gap-6">
        <h2 class="text-2xl lg:text-3xl font-bold leading-tight">
          {t('products.q_title')} <span class="text-brand-cyan">&laquo;{t('products.q_titleHighlight')}&raquo;</span>
        </h2>
        <p class="text-sm lg:text-base text-white/70 leading-relaxed">
          {t('products.q_text')}
        </p>
        <div>
          <a href="#contact" class="btn-primary">{t('products.q_cta')}</a>
        </div>
      </div>
      <div class="lg:w-[40%] min-h-[300px] lg:min-h-[500px] bg-brand-purple/60">
        <img
          src="/images/product-questions.svg"
          alt={`${t('products.q_titleHighlight')} - ${t('products.q_cta')}`}
          class="w-full h-full object-cover"
          width="614"
          height="650"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Product 2: Button system -->
    <div class="flex flex-col lg:flex-row-reverse gap-0 rounded-2xl overflow-hidden">
      <div class="lg:w-[60%] bg-brand-purple/40 p-8 lg:p-16 flex flex-col justify-center gap-6">
        <h2 class="text-2xl lg:text-3xl font-bold leading-tight">
          {t('products.b_title')} <span class="text-brand-cyan">{t('products.b_titleHighlight')}</span>
        </h2>
        <p class="text-sm lg:text-base text-white/70 leading-relaxed">
          {t('products.b_text')}
        </p>
        <div>
          <a href="#contact" class="btn-primary">{t('products.b_cta')}</a>
        </div>
      </div>
      <div class="lg:w-[40%] min-h-[300px] lg:min-h-[500px] bg-brand-purple/60">
        <img
          src="/images/product-buttons.svg"
          alt={`${t('products.b_titleHighlight')} - ${t('products.b_cta')}`}
          class="w-full h-full object-cover"
          width="614"
          height="650"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
