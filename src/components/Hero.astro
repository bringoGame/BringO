---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section class="pt-[120px] pb-16 lg:pt-[140px] lg:pb-24 px-6 lg:px-[170px]">
  <div class="max-w-[1920px] mx-auto flex flex-col lg:flex-row items-center gap-10 lg:gap-16">
    <!-- Left: Text content -->
    <div class="lg:w-[45%] flex flex-col gap-8">
      <h1 class="text-3xl sm:text-4xl lg:text-[44px] font-bold leading-tight">
        {t('hero.title1')}
        <span class="text-brand-cyan">{t('hero.titleHighlight')}</span>
        {t('hero.title2')}
      </h1>
      <p class="text-white/70 text-base lg:text-lg">
        {t('hero.subtitle')}
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="#contact" class="btn-primary">
          {t('hero.cta1')}
        </a>
        <a href="#franchise" class="btn-outline">
          {t('hero.cta2')}
        </a>
      </div>
    </div>

    <!-- Right: Hero image -->
    <div class="lg:w-[55%] relative">
      <div class="relative rounded-2xl overflow-hidden aspect-[1026/695] bg-brand-purple/50">
        <img
          src="/images/hero-main.svg"
          alt={t('hero.heroAlt')}
          class="w-full h-full object-cover rounded-2xl"
          width="1026"
          height="695"
          loading="eager"
        />
        <!-- Decorative ellipse glow -->
        <div class="absolute -left-20 -top-20 w-[390px] h-[405px] bg-brand-magenta/20 rounded-full blur-[100px] pointer-events-none"></div>
      </div>

      <!-- Feature badges row -->
      <div class="flex flex-wrap gap-3 mt-6 justify-center lg:justify-start">
        <div class="glass-card px-5 py-4 flex flex-col items-center gap-2 w-[150px] sm:w-[180px]">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-brand-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <span class="text-xs text-center text-white/80">{t('hero.badge1')}</span>
        </div>
        <div class="glass-card px-5 py-4 flex flex-col items-center gap-2 w-[150px] sm:w-[180px]">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-brand-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          <span class="text-xs text-center text-white/80">{t('hero.badge2')}</span>
        </div>
        <div class="glass-card px-5 py-4 flex flex-col items-center gap-2 w-[150px] sm:w-[180px]">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-brand-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          <span class="text-xs text-center text-white/80">{t('hero.badge3')}</span>
        </div>
        <div class="glass-card px-5 py-4 flex flex-col items-center gap-2 w-[150px] sm:w-[180px]">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-brand-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <span class="text-xs text-center text-white/80">{t('hero.badge4')}</span>
        </div>
      </div>
    </div>
  </div>
</section>
