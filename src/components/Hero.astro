---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section class="pt-[70px] pb-16 lg:pt-[70px] lg:pb-24 px-6 lg:px-[170px] relative">
  <div class="hero-grid max-w-[1920px] mx-auto">

    <!-- Social sidebar (right edge) -->
    <div class="hidden lg:flex flex-col items-center gap-[45px] absolute right-[60px] top-[357px]" style="z-index: 10;">
      <a href="https://www.instagram.com/bringo_activities" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <img src="/images/social-instagram.svg" alt="Instagram" class="w-[30px] h-[30px]" />
      </a>
      <a href="https://t.me/bring_O" target="_blank" rel="noopener noreferrer" aria-label="Telegram">
        <img src="/images/social-telegram.svg" alt="Telegram" class="w-[30px] h-[30px]" style="filter: brightness(0) saturate(100%) invert(70%) sepia(52%) saturate(478%) hue-rotate(131deg) brightness(96%) contrast(92%);" />
      </a>
      <a href="https://wa.me/40743460840" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
        <img src="/images/icon-whatsapp.svg" alt="WhatsApp" class="w-[36px] h-[30px]" style="filter: brightness(0) saturate(100%) invert(70%) sepia(52%) saturate(478%) hue-rotate(131deg) brightness(96%) contrast(92%);" />
      </a>
    </div>

    <!-- Text content -->
    <div class="hero-text flex flex-col gap-[65px]">
      <h1 class="font-['Roboto_Slab'] font-semibold text-[32px] leading-[115%] md:text-[40px] lg:text-[52px] lg:leading-[115%]">
        {t('hero.title1')}
        <span class="text-brand-cyan">{t('hero.titleHighlight')}</span>
        {t('hero.title2')}
      </h1>
      <p class="text-white text-[16px] leading-[115%] lg:text-[24px] lg:leading-[115%]">
        {t('hero.subtitle')}
      </p>
      <div class="flex flex-col md:flex-row lg:flex-row gap-[45px] md:gap-[34px] lg:gap-[34px]">
        <a href="#contact" class="hero-btn-cyan w-full md:w-auto lg:w-auto">
          {t('hero.cta1')}
        </a>
        <a href="#franchise" class="hero-btn-magenta w-full md:w-auto lg:w-auto">
          {t('hero.cta2')}
        </a>
      </div>
    </div>

    <!-- Hero image + badges (same div so badges match image width) -->
    <div class="hero-image relative">
      <div class="hero-image-wrap relative rounded-2xl overflow-visible">
        <img
          src="/images/hero-main.png"
          alt=""
          class="absolute inset-0 w-full h-full object-cover rounded-2xl blur-[14.6px] lg:blur-[45px] scale-105 opacity-60"
          aria-hidden="true"
        />
        <img
          src="/images/hero-main.png"
          alt={t('hero.heroAlt')}
          class="relative w-full h-full object-cover rounded-2xl"
          width="1026"
          height="695"
          loading="eager"
        />
      </div>

      <!-- Feature badges (inside image div to inherit width) -->
      <div class="hero-badges flex flex-col items-center lg:flex-row lg:justify-between gap-[35px] lg:gap-0 mt-6 lg:mx-[4.375rem]">
        <div class="hero-badge">
          <img src="/images/icon-question.svg" alt="" class="w-10 h-10" />
          <span class="text-[16px] leading-[115%] text-center text-white">{t('hero.badge1')}</span>
        </div>
        <div class="hero-badge">
          <img src="/images/icon-launch.svg" alt="" class="w-10 h-10" />
          <span class="text-[16px] leading-[115%] text-center text-white">{t('hero.badge2')}</span>
        </div>
        <div class="hero-badge">
          <img src="/images/icon-fits.svg" alt="" class="w-10 h-10" />
          <span class="text-[16px] leading-[115%] text-center text-white">{t('hero.badge3')}</span>
        </div>
        <div class="hero-badge">
          <img src="/images/icon-calendar.svg" alt="" class="w-10 h-10" />
          <span class="text-[16px] leading-[115%] text-center text-white">{t('hero.badge4')}</span>
        </div>
      </div>
    </div>

    <!-- Mobile-only badges (separate div for mobile ordering) -->
    <div class="hero-badges-mobile">
      <div class="hero-badge">
        <img src="/images/icon-question.svg" alt="" class="w-10 h-10" />
        <span class="text-[16px] leading-[115%] text-center text-white">{t('hero.badge1')}</span>
      </div>
      <div class="hero-badge">
        <img src="/images/icon-launch.svg" alt="" class="w-10 h-10" />
        <span class="text-[16px] leading-[115%] text-center text-white">{t('hero.badge2')}</span>
      </div>
      <div class="hero-badge">
        <img src="/images/icon-fits.svg" alt="" class="w-10 h-10" />
        <span class="text-[16px] leading-[115%] text-center text-white">{t('hero.badge3')}</span>
      </div>
      <div class="hero-badge">
        <img src="/images/icon-calendar.svg" alt="" class="w-10 h-10" />
        <span class="text-[16px] leading-[115%] text-center text-white">{t('hero.badge4')}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-btn-cyan {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 20px 25px;
    background: #57CCD5;
    border-radius: 10px;
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 24px;
    color: #FFFFFF;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }
  .hero-btn-cyan:hover {
    background: #4bb8c0;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(87, 204, 213, 0.4);
  }

  .hero-btn-magenta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 20px 25px;
    background: #EB3CDE;
    border-radius: 10px;
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 24px;
    color: #FFFFFF;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }
  .hero-btn-magenta:hover {
    background: #d632c9;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(235, 60, 222, 0.4);
  }

  /* Mobile layout */
  .hero-grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .hero-text { order: 2; }
  .hero-image { order: 1; }

  .hero-image .hero-image-wrap {
    max-width: 335px;
    margin: 0 auto;
  }

  /* Hide badges inside image div on mobile, show separate mobile badges */
  .hero-badges { display: none; }
  .hero-badges-mobile { order: 3; display: flex; flex-direction: column; align-items: center; gap: 35px; }

  @media (min-width: 768px) {
    .hero-image .hero-image-wrap {
      max-width: none;
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .hero-grid {
      display: grid;
      grid-template-columns: 33% 1fr;
      grid-template-areas: "text image";
      gap: 36px;
      align-items: center;
    }

    .hero-text { grid-area: text; order: unset; }
    .hero-image { grid-area: image; order: unset; }

    .hero-image .hero-image-wrap {
      max-width: none;
      margin: 0;
    }

    /* Show badges inside image div on desktop, hide mobile badges */
    .hero-badges { display: flex; }
    .hero-badges-mobile { display: none; }
  }

  .hero-badge {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 194px;
    height: 120px;
    border: 4px solid #57CCD5;
    border-radius: 16px;
    filter: drop-shadow(0px 4px 21.7px #5CE1E6);
  }
</style>
